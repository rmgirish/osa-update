# Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Either set DATABASE_URL (a full async SQLAlchemy URL, e.g.
# postgresql+asyncpg://user:pass@host:5432/dbname) or fill in the POSTGRES_* fields.
# DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open_source_assist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT / OTP
JWT_SECRET_KEY=replace-with-a-long-random-secret-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REMEMBER_ME_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=5

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# GitHub API & OAuth Integration
GITHUB_TOKEN=
GITHUB_MIN_REQUEST_INTERVAL=1.0
GITHUB_MAX_RETRIES=3
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173

# SMTP provider settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_START_TLS=true
SMTP_USE_TLS=false

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=open_source_repositories
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_SECONDS=2.0
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DEFAULT_POPULARITY_WEIGHT=0.3
CANDIDATE_SEARCH_LIMIT=100
DEFAULT_PAGE_LIMIT=20

# Gemini LLM configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
